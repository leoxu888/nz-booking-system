# 复制本文件为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会进 git）
# 部署到 Render / Koyeb / Fly 时，把这些变量填到平台的环境变量界面即可。

# 生产数据库：Supabase / Neon 免费 Postgres 的连接串（务必带 sslmode=require）
DATABASE_URL=postgresql://user:password@db.xxxx.supabase.co:5432/postgres?sslmode=require

# 随机长串（本地可用：python -c "import secrets;print(secrets.token_hex(32))"）
SECRET_KEY=replace-with-a-long-random-string

# 超级管理员密码（用于后台登录）
SUPER_ADMIN_PASSWORD=set-a-strong-password

# 系统发信邮箱（留空则只打印日志不真发）
SHOP_EMAIL=you@example.com

# 时区（新西兰）
SHOP_TZ=Pacific/Auckland

# 可选：Google Gemini API Key（留空则 AI 预约用本地规则解析，照常可用）
# GEMINI_API_KEY=
